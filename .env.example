# Optional. Defaults to https://www.amvco.com.au (lib/utils.ts). Only set it to
# point canonicals, the sitemap and OG URLs somewhere else, e.g. a staging domain.
# NEXT_PUBLIC_SITE_URL=https://www.amvco.com.au

# Contact form email via Web3Forms (browser-side; safe to expose publicly).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Optional: analytics (e.g. Vercel Analytics, Google Analytics).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
